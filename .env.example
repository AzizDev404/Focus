# Copy to `.env` in the repo root (never commit `.env`).

PORT=3001
NODE_ENV=development

# Required in production (min 32 characters).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Required in production: not "admin", password min 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional. Comma-separated browser origins allowed to call the API.
# Leave empty in production when the UI is served from the same host.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

APP_NAME=Focus by Tsukiyomi
MAIL_FROM=Focus by Tsukiyomi <no-reply@tsukiyomi.focus>

# OTP: true = always require email codes. false = never (even in production).
# Default in production: require codes only when SMTP_HOST and SMTP_USER are set
# so a home server without mail can still register.
REQUIRE_EMAIL_VERIFICATION=false

# Google Sign-In (optional)
GOOGLE_CLIENT_ID=

# SMTP (optional — without it, OTP codes print in the API terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Production: API also serves built frontend + admin. Set false to disable.
# SERVE_STATIC=true

# Set true only behind a trusted reverse proxy (uses X-Forwarded-For for rate limits).
# TRUST_PROXY=false
