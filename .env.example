# ─── Server ───
# Dev: API on 3001, Vite on 5173/5174 (npm run dev) — visit frontend and /admin separately
# Prod: npm run build && NODE_ENV=production npm run start
NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-a-unique-random-string-at-least-32-chars
SERVE_STATIC=true

# ─── Admin panel login (/admin) — single admin account ───
ADMIN_USERNAME=change-me-admin
ADMIN_PASSWORD=replace-with-a-strong-password-min-12

# ─── Google Sign-In (optional) ───
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origin: http://localhost:5173 (dev) / your domain (prod)
GOOGLE_CLIENT_ID=

# ─── Email / OTP delivery ───
# When SMTP_HOST is empty the API logs OTP codes to the console (dev mode).
# Examples: smtp.gmail.com (use an App Password), smtp.sendgrid.net, smtp.resend.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Focus by Tsukiyomi <no-reply@example.com>"
APP_NAME=Focus by Tsukiyomi

# Force OTP verification in development (production always requires it).
REQUIRE_EMAIL_VERIFICATION=false
